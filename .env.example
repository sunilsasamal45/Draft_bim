# Resend API key for the contact form email delivery
# Get your free API key at: https://resend.com
# Steps:
#   1. Sign up at resend.com (free — 100 emails/day, no credit card)
#   2. Dashboard → API Keys → Create API Key (name it "Draft BIM")
#   3. Copy the key (starts with re_...) into RESEND_API_KEY below
#
# LOCAL DEV: create a .env file in the project root with this line:
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# VERCEL PRODUCTION: add this in Vercel dashboard →
#   Project → Settings → Environment Variables

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
